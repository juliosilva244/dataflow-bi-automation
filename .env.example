# O dashboard funciona sem IA. Cada usuário informa sua chave Groq temporariamente
# na própria sessão; não configure chaves globais neste arquivo.
GROQ_MODEL=openai/gpt-oss-20b
DATAFLOW_DISPLAY_NAME=Visitante

# Governança de uploads
DATAFLOW_MAX_UPLOAD_MB=10
DATAFLOW_MAX_ROWS=100000
DATAFLOW_MAX_COLUMNS=100
DATAFLOW_MAX_XLSX_UNCOMPRESSED_MB=100
DATAFLOW_MAX_XLSX_ENTRIES=5000
DATAFLOW_MAX_ZIP_COMPRESSION_RATIO=100

# Desempenho (cache isolado por sessão e apresentação de tabelas)
DATAFLOW_CACHE_TTL_SECONDS=900
DATAFLOW_CACHE_MAX_ENTRIES=8
DATAFLOW_TABLE_PAGE_SIZE=100
DATAFLOW_EXCEL_WIDTH_SAMPLE_ROWS=200

# Governança de IA
DATAFLOW_AI_ANONYMIZE_DEFAULT=true
DATAFLOW_AI_TIMEOUT_SECONDS=20
DATAFLOW_AI_MAX_RETRIES=1
DATAFLOW_AI_REQUESTS_PER_MINUTE=5
DATAFLOW_AI_MAX_OUTPUT_TOKENS=700

# Parâmetros dos insights analíticos
DATAFLOW_INSIGHT_PRODUCT_SHARE_WARNING=30
DATAFLOW_INSIGHT_PRODUCT_SHARE_CRITICAL=45
DATAFLOW_INSIGHT_STORE_CRITICAL=60
DATAFLOW_INSIGHT_STORE_WARNING=80
DATAFLOW_INSIGHT_REVENUE_GROWTH_POSITIVE=15
DATAFLOW_INSIGHT_REVENUE_GROWTH_NEGATIVE=-10
DATAFLOW_INSIGHT_TICKET_REFERENCE_MINIMUM=100
DATAFLOW_INSIGHT_TICKET_GROWTH_POSITIVE=8

